# The EXPO_PUBLIC_ prefix is required, expo only exposes variables with
# this prefix to the app at runtime.

# Replace localhost with your machine's local IP address when testing 
# on a phone over WiFi.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# Number of frames per replay chunk (must match backend REPLAY_CHUNK_SIZE)
EXPO_PUBLIC_REPLAY_CHUNK_SIZE=25

# Seconds between frames at 1× playback speed (must match backend REPLAY_FRAME_INTERVAL)
EXPO_PUBLIC_REPLAY_FRAME_INTERVAL_SEC=0.04

# How many seconds the skip-backward / skip-forward buttons jump
EXPO_PUBLIC_REPLAY_SKIP_SECONDS=10