# Buffer capacity for event stream
EVENT_BUFFER=200

# Buffer capacity for positional stream
POSITIONAL_BUFFER=2500

# Per-client queue capacity for event stream
EVENT_QUEUE_SIZE=50

# Per-client queue capacity for positional stream
POSITIONAL_QUEUE_SIZE=250

# Size of chunk for xml data loading
CHUNK_SIZE=500

# Match identifier for the simulated match
MATCH_ID=DFL-MAT-111111

REDIS_URL=

# Number of positional frames stored as one Redis chunk (must match frontend EXPO_PUBLIC_REPLAY_CHUNK_SIZE)
REPLAY_CHUNK_SIZE=25

# Seconds between frames when streaming replay at 1× speed (1 / frame-rate, must match frontend EXPO_PUBLIC_REPLAY_FRAME_INTERVAL_SEC)
REPLAY_FRAME_INTERVAL=0.04

# Seconds to retain replay data in Redis before automatic expiry
REPLAY_STREAM_TTL=10800

# Seconds between polls when the replay stream has caught up to the live edge
REPLAY_IDLE_POLL_INTERVAL=0.1

# Number of consecutive idle polls before the replay stream ends
REPLAY_IDLE_LIMIT=50

# Secret key for signing JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
